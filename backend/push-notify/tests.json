{
  "tests": [
    {
      "name": "Get VAPID public key",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "vapid_key"
      },
      "expectedStatus": 200
    },
    {
      "name": "Subscribe without user returns 400",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "subscribe"
      },
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "send_group without group_id returns 400",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "send_group"
      },
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "register_native without user returns 400",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "register_native"
      },
      "expectedStatus": 400,
      "bodyMatcher": "partial"
    },
    {
      "name": "Подписка с поддельным ключом отклоняется",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-User-Id": "1",
        "X-Auth-Token": "1.fake"
      },
      "body": {
        "action": "register_native",
        "token": "x"
      },
      "expectedStatus": 401
    }
  ]
}