    {
      "name": "Чужой ключ отклоняется",
      "method": "POST",
      "path": "/",
      "headers": {
        "X-User-Id": "1",
        "X-Auth-Token": "2.fake-token"
      },
      "body": {
        "action": "get_chats"
      },
      "expectedStatus": 401,
      "expectedBody": {
        "auth_required": true
      },
      "bodyMatcher": "partial"
    },
    {
